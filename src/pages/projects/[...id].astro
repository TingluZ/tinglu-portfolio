---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib';
import { url } from '../../site';

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const { title, result, tags, code, demo, post } = project.data;
---

<Base title={title} description={project.data.summary}>
	<article class="container">
		<header>
			<p class="back"><a href={url('/projects')}>← Projects</a></p>
			<h1>{title}</h1>
			<p class="result">{result}</p>
			<ul class="tags">{tags.map((t) => <li class="tag">{t}</li>)}</ul>
			<div class="actions">
				{demo && <a class="button primary" href={demo}>Try the demo</a>}
				{code && <a class="button" href={code}>Code</a>}
				{post && <a class="button" href={url(post)}>Blog post</a>}
			</div>
		</header>
		<div class="prose">
			<Content />
		</div>
	</article>
</Base>

<style>
	header { margin-top: 2.5rem; }
	.back { margin: 0 0 1rem; font-size: 0.9rem; }
	.back a { color: var(--muted); text-decoration: none; }
	.result { font-size: 1.15rem; margin: 0.25rem 0 1rem; }
</style>
