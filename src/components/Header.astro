---
import { SITE, url } from '../site';

const nav = [
	{ href: '/projects', label: 'Projects' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/about', label: 'About' },
];
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
---

<header class="site-header">
	<div class="container wide bar">
		<a class="brand" href={url('/')}>{SITE.name}</a>
		<nav aria-label="Main">
			{
				nav.map((item) => (
					<a href={url(item.href)} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
			<button id="theme-toggle" type="button" aria-label="Toggle dark mode">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
			</button>
		</nav>
	</div>
</header>

<script is:inline>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const root = document.documentElement;
		const dark = root.dataset.theme
			? root.dataset.theme === 'dark'
			: matchMedia('(prefers-color-scheme: dark)').matches;
		root.dataset.theme = dark ? 'light' : 'dark';
		try { localStorage.setItem('theme', root.dataset.theme); } catch {}
	});
</script>

<style>
	.site-header { border-bottom: 1px solid var(--border); }
	.bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; height: 3.75rem; }
	.brand { font-weight: 650; color: var(--text); text-decoration: none; white-space: nowrap; }
	nav { display: flex; align-items: center; gap: 1.1rem; }
	nav a { color: var(--muted); text-decoration: none; font-size: 0.95rem; }
	nav a:hover, nav a[aria-current='page'] { color: var(--text); }
	button { background: none; border: 0; color: var(--muted); cursor: pointer; padding: 0.25rem; display: inline-flex; }
	button:hover { color: var(--text); }
</style>
